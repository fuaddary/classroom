       ═══════════════════════════════════════════ -->
  <question type="shortanswer">
    <name>
      <text>HTML — Tag untuk heading paling penting di halaman</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
        <p>Dalam HTML, tag heading mana yang memiliki tingkatan/hierarki
        <strong>paling tinggi</strong> (paling penting secara semantik)?
        Tulis tag-nya (contoh format: <code>&lt;h1&gt;</code>)</p>
      ]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[
        <p>Jawaban: <code>&lt;h1&gt;</code> — Heading level 1 adalah
        judul utama halaman, dan hanya boleh ada 1 per halaman untuk
        praktik SEO yang baik.</p>
      ]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>

    <answer fraction="100">
      <text>&lt;h1&gt;</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar! <code>&lt;h1&gt;</code> adalah heading tertinggi.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>h1</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar (tanpa tag bracket juga diterima).</p>]]></text>
      </feedback>
    </answer>
  </question>

