  <!-- ═══════════════════════════════════════════
       SOAL 1 — Properti CSS untuk warna teks
       ═══════════════════════════════════════════ -->
  <question type="shortanswer">
    <name>
      <text>CSS — Properti untuk mengubah warna teks</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
        <p>Properti CSS apakah yang digunakan untuk mengubah
        <strong>warna teks</strong> sebuah elemen?
        (Tulis nama properti saja, tanpa nilai)</p>
      ]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[
        <p>Properti CSS untuk warna teks adalah <code>color</code>.
        Contoh: <code>color: #333;</code> atau <code>color: red;</code></p>
      ]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase><!-- 0 = case-insensitive -->

    <!-- Semua variasi jawaban yang diterima -->
    <answer fraction="100">
      <text>color</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar! <code>color</code> adalah properti CSS untuk warna teks.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>color:</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar (dengan titik dua juga diterima).</p>]]></text>
      </feedback>
    </answer>
  </question>

