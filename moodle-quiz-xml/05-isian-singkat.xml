  <!-- ═══════════════════════════════════════════
       SOAL 3 — Method JavaScript memilih elemen by ID
       ═══════════════════════════════════════════ -->
  <question type="shortanswer">
    <name>
      <text>JavaScript — Method bawaan untuk memilih elemen by ID</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[
        <p>Tuliskan nama <strong>method JavaScript bawaan (vanilla)</strong>
        yang digunakan untuk memilih elemen HTML berdasarkan
        atribut <code>id</code>-nya.
        (Tulis nama method saja, tanpa <code>document.</code>)</p>
      ]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[
        <p>Jawaban: <code>getElementById</code><br>
        Digunakan sebagai <code>document.getElementById('nama-id')</code></p>
      ]]></text>
    </generalfeedback>
    <defaultgrade>1</defaultgrade>
    <penalty>0</penalty>
    <hidden>0</hidden>
    <usecase>0</usecase>

    <answer fraction="100">
      <text>getElementById</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar!</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="100">
      <text>getElementById()</text>
      <feedback format="html">
        <text><![CDATA[<p>✅ Benar (dengan tanda kurung juga diterima).</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="50">
      <text>querySelector</text>
      <feedback format="html">
        <text><![CDATA[<p>⚠️ Hampir benar! <code>querySelector</code> juga bisa digunakan, tapi jawaban yang lebih spesifik adalah <code>getElementById</code>.</p>]]></text>
      </feedback>
    </answer>
  </question>

  <!-- ═══════════════════════════════════════════
